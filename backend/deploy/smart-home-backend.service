[Unit]
Description=Smart Home Security FastAPI backend
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=thomsontea
Group=thomsontea
SupplementaryGroups=dialout video
WorkingDirectory=/home/thomsontea/smart_home_security_system/backend
EnvironmentFile=/home/thomsontea/smart_home_security_system/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/thomsontea
ExecStart=/home/thomsontea/smart_home_security_system/backend/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
